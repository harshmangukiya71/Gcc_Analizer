# ==============================================================================
# GCC COMPASS PLATFORM CONFIGURATION
# ==============================================================================

# PostgreSQL Connection URL
# Replace 'YOUR_PASSWORD_HERE' with your PostgreSQL password
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD_HERE@localhost:5432/gcc_compass

# Connection Pool Settings (Tuned for high-throughput scaling)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Data Source Locations
DATA_CSV_PATH=data/raw/GCC-Journal-India-List.csv
DATA_EXCEL_PATH=D:\GCC-Journal-India-List.xlsx

# Application Environment
APP_ENV=development
